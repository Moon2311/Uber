{
  "DriverAvailabilityChanged.v1": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "DriverAvailabilityChanged v1",
    "description": "",
    "type": "object",
    "properties": {
      "driver_id": {
        "type": "integer"
      },
      "status": {
        "type": "string"
      },
      "previous_status": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "reason": {
        "type": "string"
      },
      "vehicle_category": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "changed_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "driver_id",
      "status",
      "previous_status",
      "reason",
      "vehicle_category",
      "changed_at"
    ]
  },
  "DriverLocationUpdated.v1": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "DriverLocationUpdated v1",
    "description": "Sampled driver position. NOT every GPS ping.",
    "type": "object",
    "properties": {
      "driver_id": {
        "type": "integer"
      },
      "lat": {
        "type": "string",
        "pattern": "^-?\\d+(\\.\\d+)?$"
      },
      "lng": {
        "type": "string",
        "pattern": "^-?\\d+(\\.\\d+)?$"
      },
      "recorded_at": {
        "type": "string",
        "format": "date-time"
      },
      "h3_cell": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "h3_resolution": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "heading": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "speed_kmh": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "driver_id",
      "lat",
      "lng",
      "recorded_at",
      "h3_cell",
      "h3_resolution",
      "reason"
    ]
  },
  "RideAccepted.v1": {
