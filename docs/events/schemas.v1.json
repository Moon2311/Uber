  "TripCompleted.v1": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TripCompleted v1",
    "description": "Informational. The trip and payment records in PostgreSQL remain authoritative; never settle payments from this event.",
    "type": "object",
    "properties": {
      "trip_id": {
        "type": "string",
        "format": "uuid"
      },
      "rider_id": {
        "type": "integer"
      },
      "driver_id": {
        "type": "integer"
      },
      "ride_category": {
        "type": "string"
      },
      "estimated_fare": {
        "type": "string",
        "pattern": "^-?\\d+(\\.\\d+)?$"
      },
      "final_fare": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          },
          {
            "type": "null"
          }
        ]
      },
      "currency": {
        "type": "string"
      },
      "estimated_distance_km": {
        "type": "string",
        "pattern": "^-?\\d+(\\.\\d+)?$"
      },
      "started_at": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time"
          },
          {
            "type": "null"
          }
        ]
      },
      "completed_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "trip_id",
      "rider_id",
      "driver_id",
      "ride_category",
      "estimated_fare",
      "final_fare",
      "currency",
      "estimated_distance_km",
      "started_at",
      "completed_at"
    ]
  },
