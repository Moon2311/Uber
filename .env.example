# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=ridehailing
POSTGRES_USER=ridehailing
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433

# --- Django ---
DJANGO_DEBUG=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Used when running the backend on the host (outside docker).
DATABASE_URL=postgres://ridehailing:change-me@localhost:5433/ridehailing
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# json (production) or text (local dev)
LOG_FORMAT=text

# --- Location service ---
DRIVER_LOCATION_STALE_SECONDS=120
DRIVER_AUTO_OFFLINE_SECONDS=900
LOCATION_MAX_AGE_SECONDS=300
LOCATION_MAX_FUTURE_SKEW_SECONDS=30
LOCATION_HISTORY_ENABLED=true
LOCATION_HISTORY_MIN_INTERVAL_SECONDS=30
LOCATION_HISTORY_MIN_DISTANCE_M=100
LOCATION_HISTORY_RETENTION_DAYS=30

# --- H3 geographic indexing ---
# 8 ~ 0.53 km hexagon edge. Run `make reindex-locations` after changing.
H3_RESOLUTION=8
H3_MAX_GRID_DISTANCE=40
# h3 | bbox (retained fallback)
NEARBY_SEARCH_STRATEGY=h3

# --- Redis hot store (live locations) ---
REDIS_HOST_PORT=6380
# Used when running the backend on the host; docker compose overrides it.
REDIS_URL=redis://localhost:6380/0
REDIS_KEY_PREFIX=rh
# redis (default) or postgres
LOCATION_STORE=redis
# postgres (degrade on Redis outage) or none (return 503)
LOCATION_STORE_FALLBACK=postgres

# --- Kafka (event streaming) ---
KAFKA_HOST_PORT=9094
# Host-side address; docker compose sets kafka:9092 for containers.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_ENABLED=true
LOCATION_EVENT_MIN_INTERVAL_SECONDS=15

# --- Matching ---
MATCHING_OFFER_TTL_SECONDS=15
MATCHING_TIMEOUT_SECONDS=120
# fallback (labelled straight-line estimate) or osrm (needs ETA_OSRM_URL)
ETA_PROVIDER=fallback
ETA_OSRM_URL=

# --- Real-time (WebSockets) ---
CHANNEL_LAYER_BACKEND=redis
REALTIME_HEARTBEAT_INTERVAL_SECONDS=25
REALTIME_HEARTBEAT_TIMEOUT_SECONDS=60
# Defaults to CORS_ALLOWED_ORIGINS
# REALTIME_ALLOWED_ORIGINS=http://localhost:5173
REALTIME_ALLOW_MISSING_ORIGIN=true

# --- Pricing (surge is an ILLUSTRATIVE policy: check local law before enabling) ---
PRICING_SURGE_ENABLED=true
PRICING_SURGE_HARD_CAP=3.0
# Comma-separated H3 zones where surge must never apply
PRICING_SURGE_DISABLED_ZONES=
PRICING_QUOTE_TTL_SECONDS=300

# --- Payments ---
# sandbox only (no real provider is integrated yet). Refused when DEBUG=false
# unless PAYMENTS_SANDBOX_ALLOWED=true.
PAYMENTS_PROVIDER=sandbox
# Webhook HMAC secrets, comma-separated (first signs, all verify: rotation).
# Generate: python -c "import secrets; print('whsec_' + secrets.token_hex(24))"
PAYMENTS_WEBHOOK_SECRETS=change-me

# --- Notifications ---
NOTIFICATIONS_PROVIDER=sandbox

# --- Environment / production readiness (Step 10) ---
# development | test | staging | production. staging/production refuse DEBUG and
# are gated by `manage.py check --deploy` (run by the migrate job).
APP_ENV=development
# JWT_SIGNING_KEY=<different from DJANGO_SECRET_KEY in staging/production>
# Load balancer hops in front of the app (client IP for rate limiting). 1 behind one LB.
# NUM_PROXIES=1
# Rate-limit counters: redis (required when deployed) or locmem (single process).
# CACHE_BACKEND=locmem
# Metrics: apps.common.metrics.PrometheusMetrics in deployed environments.
# METRICS_TOKEN=<bearer token Prometheus scrapes /metrics with>
# SENTRY_DSN=
# ADMIN_URL_PATH=admin/
# API_DOCS_ENABLED=true
# GUNICORN_WORKERS=3
